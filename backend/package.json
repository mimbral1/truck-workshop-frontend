{
  "name": "truck-workshop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend monolitico modular TypeScript para Truck Workshop con SQL Server.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "migrate": "tsx scripts/migrate.js",
    "seed": "tsx scripts/seed.js",
    "seed:generate": "tsx scripts/generate-seed-data.js",
    "seed:from-mocks": "npm run seed:generate && npm run seed",
    "db:reset": "npm run migrate && npm run seed:from-mocks",
    "check": "tsc --noEmit && npm test && tsx scripts/check-security.js && tsx scripts/audit-frontend-contract.js && tsx scripts/smoke-api.js",
    "smoke": "tsx scripts/smoke-api.js",
    "db:audit": "tsx scripts/audit-database.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "msnodesqlv8": "^5.1.9",
    "mssql": "^12.2.0",
    "truck-workshop": "file:..",
    "truck-workshop-frontend": "file:../frontend",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.19.20",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.12",
    "nodemon": "^3.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
